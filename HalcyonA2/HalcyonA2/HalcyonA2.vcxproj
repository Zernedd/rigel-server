<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- Which A2 build the payload targets. Selects gamesdk\<GameBuild>\ (the Dumper-7 SDK for
       that binary) and the matching block in GameOffsets.h. Override on the command line:
         msbuild HalcyonA2.sln /p:GameBuild=20996
       Known builds: 20996 (Nov 2024 Rift build), 22284 (the "Nov15" build). -->
  <PropertyGroup>
    <GameBuild Condition="'$(GameBuild)'==''">22284</GameBuild>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7B0E9C21-3F4A-4B8D-9C11-A2D5E6F70001}</ProjectGuid>
    <RootNamespace>HalcyonA2</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>HalcyonA2</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(GameBuild)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\int\$(ProjectName)-$(GameBuild)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>HalcyonA2</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- The Dumper-7 SDK translation units blow past the default section limit. -->
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)gamesdk\$(GameBuild);$(ProjectDir)gamesdk\$(GameBuild)\SDK;$(SolutionDir)ThirdParty\MinHook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- WIN32_LEAN_AND_MEAN / NOMINMAX are NOT set here: the generated SDK/Basic.hpp defines
           them itself, and a command-line copy makes every SDK translation unit warn C4005.
           pch.h defines them (guarded) for our own sources. -->
      <PreprocessorDefinitions>HALCYON_GAME_BUILD=$(GameBuild);_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Generated SDK code is warning-noisy; keep the signal on our own code. -->
      <DisableSpecificWarnings>4100;4189;4244;4267;4302;4311;4312;4369;4996</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ConformanceMode>false</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <!-- /EHsc: dllmain.cpp is written so no __try function holds an unwinding object (C2712). -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- [EXITTRACE] emit a linker map so CrashReporterVeh's "SELF +0xRVA" lines resolve to symbols. -->
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)HalcyonA2.map</MapFileName>
      <AdditionalDependencies>winhttp.lib;iphlpapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- Static CRT: the DLL is injected into a game process that has no VC redist guarantee. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="GameOffsets.h" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <!-- 22284 ("Nov15"): the full port supplied for that build, hardcoded to its offsets.
         20996: the original reference payload, rewired onto GameOffsets.h. -->
    <ClCompile Include="dllmain.cpp" Condition="'$(GameBuild)'=='22284'" />
    <ClCompile Include="dllmain_20996.cpp" Condition="'$(GameBuild)'=='20996'" />
  </ItemGroup>

  <!-- Dumper-7 SDK: dropped in after a dump, so it is globbed rather than listed.
       It has its own include structure and must not pull in our PCH. -->
  <ItemGroup>
    <ClCompile Include="gamesdk\$(GameBuild)\SDK\**\*.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- MinHook, compiled straight into the DLL (no separate .lib to keep in sync). -->
  <ItemGroup>
    <ClCompile Include="..\ThirdParty\MinHook\src\buffer.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="..\ThirdParty\MinHook\src\hook.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="..\ThirdParty\MinHook\src\trampoline.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="..\ThirdParty\MinHook\src\hde\hde64.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClInclude Include="..\ThirdParty\MinHook\include\MinHook.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
