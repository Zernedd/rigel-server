# ─────────────────────────────────────────────────────────────────────────────
# Rigel server configuration — EVERY deployment-specific value lives here.
# Copy to `.env` and edit, then run ./install.sh
#
#   cp .env.example .env && nano .env && sudo ./install.sh
#
# Nothing else should need editing for a normal deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity of THIS server ──────────────────────────────────────────────────
# Public IP or hostname clients reach. Must be reachable from the internet.
# Find it with:  curl -4 ifconfig.me
PUBLIC_HOST=YOUR-VPS-IP

# Optional domain. Leave blank to run on the raw IP (no TLS).
# If set, install.sh configures Caddy + Let's Encrypt on :443 and you must
# point these DNS A records at PUBLIC_HOST first:
#   rigel-ms.<domain>   rigel.<domain>   rigel-eos.<domain>
DOMAIN=

# -- Cloudflare tunnel (reverse proxy) ---------------------------------------
# Use this INSTEAD of DOMAIN/Caddy if your rigel-* hostnames are already routed
# through a cloudflared tunnel. Cloudflare terminates TLS on 443 and the tunnel
# reaches the backend over loopback, so NO inbound service ports need opening.
#
# The DNS routes already exist and do NOT need changing - you are only moving
# WHERE the tunnel runs (from your PC to this box).
#   1. On your local PC:  cloudflared tunnel list        (note the tunnel ID)
#   2. Copy  %USERPROFILE%\.cloudflared\<TUNNEL-ID>.json  to this VPS
#   3. Set the two values below, then run install.ps1
#   4. STOP the tunnel on your local PC, or it will keep serving the old backend
#      (cloudflared load-balances between replicas - you'd get random failures)
#
# NEVER run `cloudflared tunnel route dns --overwrite-dns` - only ADD rigel-*
# records. heh.wwiggles.org is a production host and must not be touched.
CLOUDFLARED_TUNNEL=
CLOUDFLARED_CREDENTIALS=

# ── Shared secrets ───────────────────────────────────────────────────────────
# Must match HalcyonA2's -ServerApiKey (the DLL's g_serverApiKey).
# ROTATE THIS if the DLL binary has ever been shared — it used to be compiled in.
#   openssl rand -hex 32
SERVER_API_KEY=7b93a32d659d7bb73eb74c6f3f46a6a1934d47b383295a878f91ea2852d917d2

# Fixed key the dedicated game server uses for the dashboard/deployment fetch.
# Must equal A2StationDbServer.ServerMasterKey. Changing it requires a backend edit.
DASHBOARD_API_KEY=halcyon-server-key

# ── Meta / Oculus app credentials (player login attestation) ─────────────────
# From the Meta Quest Developer Dashboard for your App Lab app.
META_APP_ID=1358918123966018
META_APP_SECRET=CHANGE_ME
# The package + signing cert of YOUR client build (org.zern.rigel).
QUEST_EXPECTED_PACKAGE=org.zern.rigel
QUEST_EXPECTED_CERT_SHA=bee5fc0706704f1ed40226b7e0d95481a34f679562fcde253d2ff17bd51c1c9c

# ── Game build ───────────────────────────────────────────────────────────────
# MUST equal the client build or every station is filtered out of the browser.
BUILD_VERSION=22284

# ── Ports (defaults match the backend's hardcoded bindings) ──────────────────
PORT_MOTHERSHIP=90     # login/auth
PORT_STATIONDB=78      # stations/roles/deployments  <- DashboardApiUrl target
PORT_EOS=50            # fake EOS gateway (server list)
PORT_EOS_WS=80         # EOS websocket
PORT_DASHBOARD=8080    # backend's own web dashboard + control API
PORT_DASHBOARD_UI=3000 # the richer Next.js UI in backend/dashboard (loopback only)
PORT_ORCH_CTL=9095     # orchestrator control
PORT_ORCH_AGENT=9100   # orchestrator agent TCP
GAME_UDP_FIRST=7777    # game servers; opens GAME_UDP_FIRST..GAME_UDP_LAST
GAME_UDP_LAST=7787

# 1 = npm install + build the Next.js dashboard UI and run it as a startup task.
# Needs Node.js 20+ (winget install OpenJS.NodeJS.LTS). 0 = skip it; the backend's
# own dashboard on PORT_DASHBOARD still works without Node.
INSTALL_DASHBOARD_UI=1

# ── Security ─────────────────────────────────────────────────────────────────
# 1 = expose ONLY 443 (or the service ports if no DOMAIN) + the game UDP range.
# 0 = leave the firewall alone (NOT recommended on a public VPS).
MANAGE_FIREWALL=1

# NEVER set these to 1 on a public server. Dev/LAN only.
MOTHERSHIP_INSECURE=0      # disables ALL identity checks (full auth bypass)
MOTHERSHIP_ALLOW_NONSTORE=0 # allows a sideloaded (non-store) client to log in

# ── Runtime ──────────────────────────────────────────────────────────────────
INSTALL_DIR=/opt/rigel
SERVICE_USER=rigel
